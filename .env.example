# Copy this file to .env and set your provider API key.

# LLM configuration (any LiteLLM model string: gemini/..., openai/..., azure/..., ollama/...)
HELPDESK_LLM_MODEL=gemini/gemini-3.5-flash
HELPDESK_JUDGE_MODEL=
HELPDESK_LLM_TEMPERATURE=0.1
HELPDESK_LLM_TIMEOUT_S=60.0
HELPDESK_LLM_MIN_INTERVAL_S=0.0

# Retrieval & Qdrant
# Leave HELPDESK_QDRANT_URL empty for embedded local Qdrant in .data/qdrant
HELPDESK_QDRANT_URL=
HELPDESK_COLLECTION=helpdesk_kb
HELPDESK_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
HELPDESK_RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
HELPDESK_USE_RERANKER=true
HELPDESK_TOP_K=4
HELPDESK_CANDIDATE_K=20

# Agent
HELPDESK_MAX_AGENT_STEPS=6
HELPDESK_TOOL_BACKEND=local

# Provider API keys (configure the one matching HELPDESK_LLM_MODEL)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Azure OpenAI
# AZURE_API_KEY=
# AZURE_API_BASE=
# AZURE_API_VERSION=2024-02-15-preview

# Ollama (local)
# OLLAMA_API_BASE=http://localhost:11434
